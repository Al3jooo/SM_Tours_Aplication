// Samaria360 - Modelo lógico relacional (PostgreSQL)
// Pegar en https://dbdiagram.io para editar y exportar la imagen.

Project samaria360 {
  database_type: 'PostgreSQL'
}

Enum estado_cuenta {
  Activo
  Inactivo
  Desactivado
}

Table Cuenta [headercolor: #F6C9A0] {
  id_usuario uuid [pk, note: 'Referencia lógica a Usuario.id_usuario de auth_db, sin FK (ADR-008)']
  rol varchar(20) [not null, note: 'Turista, Prestador, Gestor o Administrador (CHECK)']
  estado varchar(20) [not null, note: 'Estado derivado: Pendiente, Activo, Rechazado, Inactivo o Desactivado (CHECK)']
  version bigint [not null, note: 'CHECK >= 1; solo avanza (upsert por versión)']
  actualizado_en timestamptz [not null]

  Note: 'reservas_db, V4 (ms-booking). Proyección del estado de las cuentas que entrega el relevo de ms-auth a PUT /internal/v1/cuentas/{id}; la usa el validador del claim ver (DEC-29). En catalog_db existe la colección equivalente «cuentas» (M003)'
}

Table Reserva_Cupo_Dia [headercolor: #F6C9A0] {
  id_reserva uuid
  id_inventario bigint
  cantidad_descontada integer [not null, note: 'CHECK > 0']

  indexes {
    (id_reserva, id_inventario) [pk]
    id_inventario [name: 'ix_reserva_cupo_dia_inventario', note: 'V1']
  }
}

Table Inventario_Cupo [headercolor: #F7E39C] {
  id_inventario bigint [pk, increment]
  id_servicio_mongo varchar(24) [not null, note: 'Referencia lógica a catalog_db, sin FK']
  categoria varchar(20) [not null, note: 'Tour o Alojamiento (CHECK)']
  id_unidad varchar(24) [null, note: 'idUnidad de catalog_db; solo Alojamiento (decisión D1)']
  fecha date [not null]
  hora_inicio time [null, note: 'Solo Tour']
  cupos_totales integer [not null, note: 'CHECK > 0']
  cupos_disponibles integer [not null, note: 'CHECK BETWEEN 0 AND cupos_totales']

  indexes {
    (id_servicio_mongo, id_unidad, fecha, hora_inicio) [unique, name: 'uq_inventario_cupo_dia', note: 'NULLS NOT DISTINCT']
  }

  Note: 'CHECK ck_inventario_cupo_forma: Alojamiento con id_unidad y sin hora_inicio; Tour con hora_inicio y sin id_unidad'
}

Table Reserva [headercolor: #A8DDB5] {
  id_reserva uuid [pk, note: 'Generado en el dominio']
  id_turista uuid [not null, note: 'sub del JWT']
  id_prestador uuid [not null]
  id_servicio_mongo varchar(24) [not null, note: 'Referencia lógica a catalog_db, sin FK']
  nombre_servicio varchar(150) [not null, note: 'Congelado al reservar (RF32)']
  categoria varchar(20) [not null, note: 'Tour o Alojamiento (CHECK)']
  id_unidad varchar(24) [null, note: 'Solo Alojamiento (decisión D1)']
  nombre_unidad varchar(100) [null, note: 'Congelado al reservar (RF32); solo Alojamiento']
  estado varchar(20) [not null, note: 'Confirmada, Cancelada o Completada (CHECK)']
  cantidad_solicitada integer [not null, note: 'Habitaciones o personas (CHECK > 0)']
  personas integer [not null, note: 'CHECK > 0']
  precio_unitario numeric(10,2) [not null]
  unidad_cobro varchar(20) [not null, note: 'Noche o Persona (CHECK)']
  monto_total numeric(12,2) [not null]
  moneda char(3) [not null, note: 'COP']
  fecha_entrada date [not null, note: 'Entrada o día del tour']
  fecha_salida date [null, note: 'Solo Alojamiento']
  hora_inicio time [null, note: 'Solo Tour']
  fecha_inicio timestamptz [not null]
  fecha_fin timestamptz [not null]
  fecha_creacion timestamptz [not null]
  fecha_cancelacion timestamptz [null, note: 'RF18']
  clave_idempotencia uuid [not null, note: 'Idempotency-Key (decisión D6)']
  hash_solicitud char(64) [not null, note: 'SHA-256 del pedido normalizado']

  indexes {
    (id_turista, clave_idempotencia) [unique, name: 'uq_reserva_turista_clave']
    (id_turista, fecha_creacion)
    (id_prestador, fecha_entrada)
    (id_turista, fecha_inicio, id_reserva) [name: 'ix_reserva_turista_inicio', note: 'V2; fecha_inicio DESC, id_reserva DESC («Mis reservas», RF12)']
    fecha_fin [name: 'ix_reserva_confirmada_fin', note: 'V3; índice parcial WHERE estado = \'Confirmada\' (RF52)']
  }

  Note: 'CHECK ck_reserva_forma: Alojamiento con id_unidad, nombre_unidad y fecha_salida, sin hora_inicio, cobro por Noche; Tour con hora_inicio, sin unidad ni fecha_salida, cobro por Persona'
}

Table Turista_Categoria_Interes [headercolor: #C5E3A5] {
  id_usuario uuid
  categoria varchar(50) [note: 'Naturaleza, Cultura o Aventura (CHECK, V4; decisión D1)']

  indexes {
    (id_usuario, categoria) [pk]
  }
}

Table Turista [headercolor: #A6DFEE] {
  id_usuario uuid [pk]
  primer_nombre varchar(50) [not null]
  segundo_nombre varchar(50) [null]
  primer_apellido varchar(50) [not null]
  segundo_apellido varchar(50) [null]
  pais_origen varchar(2) [not null, note: 'ISO 3166-1 alfa-2, p. ej. CO (CHECK ^[A-Z]{2}$, V8; decisión D5)']
  acepto_politicas boolean [not null]
}

Table Outbox_Evento [headercolor: #F2A9A9] {
  id_evento bigint [pk, increment]
  tipo varchar(50) [not null, note: 'CuentaActualizada (CHECK)']
  id_usuario uuid [not null]
  carga jsonb [not null, note: '{idUsuario, rol, estadoCuenta, version}']
  creado_en timestamptz [not null]

  indexes {
    (id_usuario, id_evento) [name: 'ix_outbox_evento_usuario', note: 'V13; id_evento DESC']
  }

  Note: 'V13. Outbox transaccional (DEC-26): el evento se inserta en la misma transacción que el cambio de estado'
}

Table Outbox_Entrega [headercolor: #F2A9A9] {
  id_evento bigint
  destino varchar(20) [note: 'ms-catalog o ms-booking (CHECK)']
  entregado_en timestamptz [null]
  intentos integer [not null, note: 'CHECK >= 0']
  proximo_intento timestamptz [not null, note: 'También es el arriendo de la entrega reclamada (FOR UPDATE SKIP LOCKED)']
  ultimo_error varchar(500) [null]

  indexes {
    (id_evento, destino) [pk]
    (destino, proximo_intento) [name: 'ix_outbox_entrega_pendiente', note: 'V13; índice parcial WHERE entregado_en IS NULL']
  }

  Note: 'V13. Una fila por evento y destino: un destino caído no bloquea al otro (ADR-008)'
}

Table Token_Recuperacion [headercolor: #F2A9A9] {
  id_token_recuperacion bigint [pk, increment]
  id_usuario uuid [not null]
  token_hash varchar(64) [unique, not null]
  expira_en timestamptz [not null]
  usado boolean [not null]
}

Table Usuario [headercolor: #CDBDF0] {
  id_usuario uuid [pk]
  id_rol integer [not null]
  correo varchar(100) [unique, not null]
  contrasena_hash varchar(255) [not null]
  fecha_registro date [not null]
  intentos_fallidos integer [not null]
  estado_cuenta estado_cuenta [not null, note: 'Activo, Inactivo (RF22, prestador) o Desactivado (RF62, turista; DEC-44)']
  bloqueado_hasta timestamptz [null]
  version_cuenta bigint [not null, note: 'V12; default 0, CHECK >= 0. Sube en 1 con cada cambio de estado o de rol (RF45); viaja en el claim ver del JWT (DEC-29). V15 la subió una vez para Gestores y Administradores y les encoló un evento (DEC-108)']
}

Table Prestador [headercolor: #A3DDD2] {
  id_usuario uuid [pk]
  razon_social varchar(150) [null, note: 'Opcional desde V5 (decisión D2): RF02 y WF-03 no la piden']
  rnt varchar(50) [unique, not null]
  telefono varchar(20) [not null]
  nombre_representante_legal varchar(150) [not null]
  correo_corporativo varchar(100) [not null]
  estado_validacion varchar(50) [not null]
  acepto_politicas boolean [not null, note: 'Sin valor por defecto (V9; decisión D6)']
  motivo_rechazo varchar(500) [null, note: 'V11; justificación del rechazo (RF28, DEC-42). CHECK: obligatoria si estado_validacion = Rechazado']
  revisado_en timestamptz [null, note: 'V11; cuándo revisó el Administrador']
  revisado_por uuid [null, note: 'V11; quién revisó. Desde V16, FK a Usuario: se conserva aunque pierda el rol de Administrador (RF45, DEC-109)']
}

Table Gestor [headercolor: #AFCDEF] {
  id_usuario uuid [pk]
}

Table Rol [headercolor: #F4B6C8] {
  id_rol integer [pk]
  nombre varchar(50) [unique, not null]
}

Table Administrador [headercolor: #B9BEEB] {
  id_usuario uuid [pk]
}

Ref: Usuario.id_rol > Rol.id_rol
Ref: Turista.id_usuario - Usuario.id_usuario
Ref: Prestador.id_usuario - Usuario.id_usuario
Ref: Gestor.id_usuario - Usuario.id_usuario
Ref: Administrador.id_usuario - Usuario.id_usuario
Ref: Token_Recuperacion.id_usuario > Usuario.id_usuario
Ref: Turista_Categoria_Interes.id_usuario > Turista.id_usuario
Ref: Reserva.id_turista > Turista.id_usuario
Ref: Reserva.id_prestador > Prestador.id_usuario
Ref: Reserva_Cupo_Dia.id_reserva > Reserva.id_reserva
Ref: Reserva_Cupo_Dia.id_inventario > Inventario_Cupo.id_inventario
Ref: Prestador.revisado_por > Usuario.id_usuario // V16 (antes, a Administrador: V11)
Ref: Outbox_Evento.id_usuario > Usuario.id_usuario
Ref: Outbox_Entrega.id_evento > Outbox_Evento.id_evento
Ref: Cuenta.id_usuario - Usuario.id_usuario // referencia lógica entre bases, sin FK física (como Reserva.id_turista)
