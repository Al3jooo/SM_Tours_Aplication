<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- El mismo parent que ms-auth y ms-catalog (Spring Boot 3.5.16, última OSS de la línea 3.x). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.unimagdalena.samaria360</groupId>
    <artifactId>ms-booking</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ms-booking</name>
    <description>Samaria360 - Microservicio de reservas (arquitectura hexagonal)</description>

    <properties>
        <java.version>17</java.version>
        <!-- La misma versión de Spring Cloud que el API Gateway: trae Spring Cloud CircuitBreaker y Resilience4j -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- No gestionadas por el BOM de Spring Boot: versión explícita, la misma que ms-auth -->
        <springdoc.version>2.8.16</springdoc.version>
        <archunit.version>1.4.2</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============ Adaptador de entrada: API REST ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============ Adaptador de salida: persistencia PostgreSQL (reservas_db) ============ -->
        <dependency>
            <!-- La reserva es una entidad JPA (ddl-auto=validate); el inventario usa SQL nativo con JdbcTemplate -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Alcance compile (no runtime), como en ms-auth: RestriccionesUnicas lee el nombre de la restricción
                 violada (clave de idempotencia repetida, D6) del campo estructurado del error, no del texto. -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Migraciones versionadas del esquema reservas_db -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============ Seguridad: validación del JWT con el JWKS de ms-auth (ADR-005) ============ -->
        <dependency>
            <!-- Igual que ms-catalog: el servicio valida el token; el gateway solo lo reenvía -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ============ Adaptador de salida: ms-catalog (ADR-007) ============ -->
        <dependency>
            <!-- Circuit breaker de la llamada síncrona a ms-catalog antes de reservar (D4, ADR-007). Su uso queda
                 confinado a infrastructure (regla ArchUnit). -->
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- ============ Operación y contrato ============ -->
        <dependency>
            <!-- /actuator/health para el healthcheck de docker-compose -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Contrato OpenAPI del servicio (solo en el perfil dev) -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============ Pruebas ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- PostgreSQL real en las pruebas de integración (concurrencia, CHECK, NULLS NOT DISTINCT) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Reglas de capas de la arquitectura hexagonal -->
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
