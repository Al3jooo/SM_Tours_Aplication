# Saltos de línea: LF en todo el repositorio, CRLF solo en scripts de Windows.
# Evita que mvnw deje de funcionar en Docker/Git Bash al editarse en Windows.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios: sin conversión de saltos de línea ni diff de texto
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.m4a binary
*.woff binary
*.woff2 binary
*.jar binary
