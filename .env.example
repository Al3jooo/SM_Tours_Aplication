# Copiar a .env (que está en .gitignore) y cambiar las contraseñas.
# docker-compose.yml exige POSTGRES_USER, POSTGRES_PASSWORD, MONGO_USER y MONGO_PASSWORD.

# Frontend (nginx) en Docker Compose: http://localhost:8000
FRONTEND_PORT=8000

POSTGRES_USER=samaria
POSTGRES_PASSWORD=cambiar_esto
# Puerto publicado en 127.0.0.1. Si el PostgreSQL de Windows ya usa el 5432, poner 5433.
POSTGRES_PORT=5432
# Host de PostgreSQL para ./mvnw (por defecto localhost). Docker Compose lo fija en "postgres".
# POSTGRES_HOST=localhost

MONGO_USER=samaria
MONGO_PASSWORD=cambiar_esto
MONGO_PORT=27017
# Host de MongoDB para ./mvnw (por defecto localhost). Docker Compose lo fija en "mongo".
# MONGO_HOST=localhost

# ms-auth
JWT_EXPIRACION_MINUTOS=60
# Rutas relativas a la carpeta del servicio (ms-auth/), desde donde se ejecuta ./mvnw spring-boot:run.
# En Docker Compose las llaves se montan como secrets en /run/secrets/ (no se usan estas rutas).
JWT_LLAVE_PRIVADA=../infra/keys/jwt-privada.pem
JWT_LLAVE_PUBLICA=../infra/keys/jwt-publica.pem

# ms-catalog (usa MONGO_USER, MONGO_PASSWORD y MONGO_PORT; la contraseña va codificada para URL si tiene caracteres especiales)
AUTH_JWKS_URI=http://localhost:8081/api/v1/auth/.well-known/jwks.json

# ms-booking (usa POSTGRES_* y AUTH_JWKS_URI; consulta el detalle público de ms-catalog antes de reservar)
MS_CATALOG_URL=http://localhost:8082
# Generador de inventario de demostración (D5): true para tener cupos de los próximos 60 días al desarrollar.
# INVENTARIO_DEMO_HABILITADO=true

# api-gateway (valores para el arranque local con ./mvnw; Docker Compose usa los nombres de la red interna)
AUTH_URI=http://localhost:8081
CATALOG_URI=http://localhost:8082
BOOKING_URI=http://localhost:8083
CORS_ORIGENES=http://localhost:5173
