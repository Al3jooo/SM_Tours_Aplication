# Copiar a .env (que está en .gitignore) y cambiar las contraseñas.
POSTGRES_USER=samaria
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_PORT=5432

MONGO_USER=samaria
MONGO_PASSWORD=cambiar_esto
MONGO_PORT=27017

# ms-auth
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
JWT_EXPIRACION_MINUTOS=60
# Rutas relativas a la carpeta del servicio (ms-auth/), desde donde se ejecuta ./mvnw spring-boot:run
JWT_LLAVE_PRIVADA=../infra/keys/jwt-privada.pem
JWT_LLAVE_PUBLICA=../infra/keys/jwt-publica.pem
